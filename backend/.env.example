# =============================================================================
# AquaCompute Backend Configuration Template
# Copy this file to `.env` (never commit `.env` to Git) and fill in your values.
# =============================================================================

# --- Application ---
APP_NAME=AquaCompute
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AWS Authentication & Target Region ---
# Leave AWS_PROFILE blank if using IAM Role (EC2/Lambda/ECS) or standard AWS env vars.
# Never hardcode AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in committed files.
AWS_REGION=<YOUR_AWS_REGION>
AWS_PROFILE=

# --- Monitored EC2 Instance (Placeholder - configure with your real instance) ---
EC2_INSTANCE_ID=<YOUR_EC2_INSTANCE_ID>
POLLING_INTERVAL_SECONDS=300
CLOUDWATCH_METRIC_PERIOD_SECONDS=300
MAX_HISTORY_HOURS=168

# --- DynamoDB Storage ---
DYNAMODB_READINGS_TABLE=AquaComputeReadings
DYNAMODB_RUNS_TABLE=AquaComputeCollectionRuns
DYNAMODB_ENDPOINT_URL=

# --- S3 Storage (Reports & RAG Source Documents) ---
S3_BUCKET_NAME=<YOUR_AQUACOMPUTE_S3_BUCKET>
S3_REPORTS_PREFIX=reports/
S3_RAG_DOCS_PREFIX=rag-docs/

# --- CloudWatch Application Logging ---
CLOUDWATCH_LOGS_ENABLED=false
CLOUDWATCH_LOG_GROUP=/aquacompute/backend
CLOUDWATCH_LOG_STREAM=api-service

# --- AquaMind RAG (Amazon Bedrock Knowledge Bases) ---
# Leave BEDROCK_KB_ID blank until your Knowledge Base is provisioned.
BEDROCK_REGION=<YOUR_BEDROCK_REGION>
BEDROCK_KB_ID=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_TOP_K=5
BEDROCK_MAX_TOKENS=700
BEDROCK_TEMPERATURE=0.2
